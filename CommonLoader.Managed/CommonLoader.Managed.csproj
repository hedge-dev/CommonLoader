<Project Sdk="Microsoft.NET.Sdk">

    <PropertyGroup>
        <TargetFramework>netstandard2.0</TargetFramework>
        <LangVersion>latest</LangVersion>
        <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
        <DebugType>embedded</DebugType>
        <EmbedAllSources>true</EmbedAllSources>
    </PropertyGroup>

    <UsingTask TaskName="ClrHost.Tasks.HexDump" AssemblyFile="$(ProjectDir)..\ClrHost.Tasks.dll"/>
    <UsingTask TaskName="ClrHost.Tasks.ImplementUnsafe" AssemblyFile="$(ProjectDir)..\ClrHost.Tasks.dll"/>

    <Target Name="PostBuild" AfterTargets="PostBuildEvent">
        <ImplementUnsafe Input="$(TargetPath)"/>
        <HexDump Input="$(TargetPath)" Output="$(ProjectDir)..\CommonLoader\clrhost\resources\$(ProjectName).cpp" />
    </Target>

</Project>
